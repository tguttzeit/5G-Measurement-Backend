# Default values for local development. Loaded automatically when no .env is present.
# These are intentionally non-secret placeholders — never use them in a real deployment.
# For anything beyond quick local testing, create a real .env (see .env.example);
# any value set there overrides what's here.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/measurement_backend
SECRET_KEY=SECRET_KEY_FOR_JWT_TOKENS_CHANGE_IN_PRODUCTION
ENVIRONMENT=development
