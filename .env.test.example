# Optional overrides for the integration test Postgres container (tests/integration/conftest.py).
# Copy to .env.test (gitignored) and export before running `pytest tests/integration` if you want
# credentials other than the built-in defaults. The container is throwaway and torn down after
# each test run, so these are never real secrets.
TEST_DB_USER=test_user
TEST_DB_PASSWORD=test_password
TEST_DB_NAME=test_db
